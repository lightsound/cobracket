# Copy to .env.local (gitignored).
# `bun run convex:dev` writes CONVEX_DEPLOYMENT, VITE_CONVEX_URL,
# and VITE_CONVEX_SITE_URL.

CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Backend selection (migration): unset or anything else keeps
# Convex, the production default. `spacetimedb` selects the
# SpacetimeDB adapter; VITE_SPACETIMEDB_HOST is then the server URL
# (e.g. http://127.0.0.1:3000) and VITE_SPACETIMEDB_DB the module
# name (cobracket).
VITE_BACKEND=
VITE_SPACETIMEDB_HOST=
VITE_SPACETIMEDB_DB=
