/*
 * Options below marked as required by SpacetimeDB must not be modified
 * (see the official `spacetime init --lang typescript` template).
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "types": [],

    /* Required by SpacetimeDB */
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "format/**/*", "spike/**/*", "bindings/**/*"]
}
