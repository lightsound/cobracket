{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/App.tsx", "src/Document.tsx"],
  "ignorePatterns": ["convex/_generated/**", "src/vite-env.d.ts"],
  "health": {
    "thresholdOverrides": [
      {
        "files": ["vite.config.ts"],
        "maxCrap": 120,
        "reason": "Cursor preview HTML buffering has no tests, so estimated CRAP is inflated"
      }
    ]
  }
}
