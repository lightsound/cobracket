{
  "name": "cobracket",
  "version": "0.0.0",
  "description": "Minimal Solid 2.0 app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vp dev",
    "dev": "vp dev",
    "build": "vp build",
    "serve": "vp preview",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "deploy": "bun run deploy:backend && bun run deploy:web",
    "deploy:backend": "convex deploy --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "deploy:web": "wrangler deploy",
    "serve:hosting": "wrangler dev",
    "test": "vp test run --project '!e2e'",
    "test:e2e": "vp test run --project e2e",
    "lint:solid": "solid2-kit check && solid2-kit doctor",
    "lint:imports": "bunx @import-lint/cli",
    "lint:theme": "bun scripts/lint-theme.ts",
    "check:bun": "bun scripts/check-bun-version.ts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "auth:keys": "bun x @convex-dev/auth",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p scripts",
    "verify": "bun run check:bun && bun run typecheck && bun run test && bun x vp check && bun run lint:imports && bun run lint:solid && bun run lint:theme && bun run build"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0-alpha.2",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solidjs/router": "2.0.0-next.26",
    "@solidjs/web": "^2.0.0-rc.9",
    "convex": "^1.46.0",
    "solid-js": "^2.0.0-rc.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@import-lint/cli": "^0.1.9",
    "@solidjs/diagnostics": "^2.0.0-rc.9",
    "@solidjs/vite-plugin": "^3.0.0-next.44",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "convex-test": "^0.0.59",
    "fallow": "^3.27.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.63.0",
    "solid2-agent-kit": "^0.13.0",
    "typescript": "^7.1.0-dev.20260921.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "wrangler": "^4.136.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
