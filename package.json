{
  "name": "cobracket",
  "version": "0.0.0",
  "description": "Minimal Solid 2.0 app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vp dev",
    "dev": "vp dev",
    "build": "vp build",
    "serve": "vp preview",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "deploy": "bun run deploy:backend && bun run deploy:web",
    "deploy:backend": "convex deploy --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "deploy:web": "cf deploy",
    "serve:hosting": "cf dev",
    "test": "vp test run --project '!e2e'",
    "test:e2e": "vp test run --project e2e",
    "lint:solid": "solid2-kit check && solid2-kit doctor",
    "lint:imports": "import-lint",
    "lint:theme": "bun scripts/lint-theme.ts",
    "check:bun": "bun scripts/check-bun-version.ts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:ci": "bun scripts/fallow-ci.ts",
    "fallow:dead-code": "fallow dead-code",
    "auth:keys": "auth",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p scripts && tsc --noEmit -p spacetimedb",
    "spacetime:build": "spacetime build",
    "spacetime:codegen": "spacetime generate --lang typescript --out-dir spacetimedb/bindings",
    "spacetime:publish:local": "spacetime publish cobracket --server local",
    "spacetime:spike": "bun spacetimedb/spike/verify-read-surfaces.ts",
    "verify": "bun run check:bun && bun run typecheck && bun run test && bun x vp check && bun run lint:imports && bun run fallow:ci && bun run lint:solid && bun run lint:theme && bun run build"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0-alpha.2",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.21",
    "convex": "^1.50.0",
    "solid-js": "^2.0.0-rc.21",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@import-lint/cli": "^0.1.9",
    "@shadcn/lint": "^0.2.0",
    "@solidjs/diagnostics": "^2.0.0-rc.21",
    "@solidjs/vite-plugin": "^3.0.0-next.57",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "cf": "^1.0.0-beta.32",
    "convex-test": "^0.0.71",
    "fallow": "3.42.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.65.1",
    "solid2-agent-kit": "0.26.0",
    "spacetimedb": "2.15.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
