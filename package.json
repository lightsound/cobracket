{
  "name": "cobracket",
  "version": "0.0.0",
  "description": "Minimal Solid 2.0 app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vp dev",
    "dev": "vp dev",
    "build": "vp build",
    "serve": "vp preview",
    "deploy": "bun run deploy:backend && bun run deploy:web",
    "deploy:backend": "spacetime publish --server maincloud --module-path spacetimedb --yes cobracket && VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com VITE_SPACETIMEDB_DB=cobracket bun run build",
    "deploy:web": "cf deploy dist/client",
    "serve:hosting": "vp preview",
    "test": "vp test run --project '!e2e' --project '!connection'",
    "test:e2e": "vp test run --project e2e",
    "test:connection": "vp test run --project connection",
    "lint:solid": "solid2-kit check && solid2-kit doctor",
    "lint:imports": "import-lint",
    "lint:theme": "bun scripts/lint-theme.ts",
    "lint:comments": "bun scripts/lint-comments.ts",
    "check:bun": "bun scripts/check-bun-version.ts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:ci": "bun scripts/fallow-ci.ts",
    "fallow:dead-code": "fallow dead-code",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p spacetimedb",
    "spacetime:build": "spacetime build",
    "spacetime:codegen": "spacetime generate --lang typescript --out-dir spacetimedb/bindings",
    "spacetime:publish:local": "spacetime publish cobracket --server http://127.0.0.1:3100 && bun run spacetime:seed:local",
    "spacetime:seed:local": "bun spacetimedb/seed-local.ts",
    "spacetime:spike": "bun spacetimedb/spike/verify-read-surfaces.ts",
    "verify": "bun run check:bun && bun run typecheck && bun run test && bun x vp check && bun run lint:imports && bun run fallow:ci && bun run lint:solid && bun run lint:theme && bun run lint:comments && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solidjs/router": "2.0.0",
    "@solidjs/web": "^2.0.1",
    "@spacetimedb/crypto": "0.1.0",
    "solid-js": "^2.0.1",
    "spacetimedb": "2.15.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@import-lint/cli": "^0.1.9",
    "@shadcn/lint": "^0.2.0",
    "@solidjs/diagnostics": "^2.0.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "cf": "^1.0.0-rc.1",
    "fallow": "3.42.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "1.65.1",
    "solid2-agent-kit": "0.29.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
