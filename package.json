{
  "name": "cobracket",
  "version": "0.0.0",
  "description": "Minimal Solid 2.0 app",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vp dev",
    "dev": "vp dev",
    "build": "vp build",
    "serve": "vp preview",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "test": "vp test run",
    "lint:solid": "solid2-kit check && solid2-kit doctor",
    "lint:imports": "bunx @import-lint/cli",
    "lint:theme": "bun scripts/lint-theme.ts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "auth:keys": "bun x @convex-dev/auth",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solidjs/web": "^2.0.0-rc.4",
    "convex": "^1.45.0",
    "solid-js": "^2.0.0-rc.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@import-lint/cli": "^0.1.9",
    "@solidjs/vite-plugin": "^3.0.0-next.36",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "convex-test": "^0.0.56",
    "fallow": "^3.20.0",
    "solid2-agent-kit": "^0.8.1",
    "typescript": "^7.1.0-dev.20260829.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
