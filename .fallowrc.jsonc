{
  "$schema": "./node_modules/fallow/schema.json",
  // Every rule is error, except `policy-violation` — see its entry for why.
  // cloudflare.config.ts and wrangler.config.ts are read by the cf and
  // wrangler CLIs, never imported: the worker config and the build-time
  // fields cf delegates to wrangler. They are entry points, not dead code.
  // The SpacetimeDB module entry (spacetimedb/src/index.ts) needs no
  // entry listing: fallow detects it as an entry point on its own and
  // reports a manual pattern for it as redundant. The two spike files
  // do need one — they are entry points of the M1 wire-level spike:
  // the driver is run by `bun run spacetime:spike`, and the fixture
  // seed is copied into the spike's assembled module; neither is
  // imported by committed code.
  "entry": [
    "src/App.tsx",
    "src/Document.tsx",
    "scripts/lint-theme.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    "spacetimedb/spike/verify-read-surfaces.ts",
    "spacetimedb/spike/fixture/seed.ts",
  ],
  // The `spacetime` CLI is installed out of band (the SpacetimeDB
  // installer), never through npm — the `spacetimedb` package ships
  // the client/module SDK and no CLI binary. The module scripts in
  // package.json (`spacetime:*`) call that system binary.
  "ignoreBinaries": ["spacetime"],
  "ignorePatterns": ["convex/_generated/**", "spacetimedb/bindings/**", "src/vite-env.d.ts"],
  // Vitest resolves the edge-runtime test environment by name from the
  // convex project in vitest.config.ts (convex-test files); it is never
  // imported directly, so static analysis cannot see the use.
  // solid2-agent-kit is a CLI-only guardrail kit: invoked as the
  // `solid2-kit` bin from the lint:solid script and from the agent hooks
  // (.cursor/hooks.json, .claude/settings.json); it is never imported.
  // happy-dom is resolved by name the same way and is deliberately absent:
  // fallow does not report it (it knows the built-in vitest environments),
  // and an ignore for a rule that never fires is a stale suppression.
  // @shadcn/lint and @convex-dev/eslint-plugin are loaded by Oxlint from the
  // `lint.jsPlugins` strings in vite.config.ts; nothing imports them.
  // @import-lint/cli is run by its bin name, `import-lint`, from the
  // lint:imports script, which fallow does not map back to the package.
  "ignoreDependencies": [
    "@convex-dev/eslint-plugin",
    "@edge-runtime/vm",
    "@import-lint/cli",
    "@shadcn/lint",
    "solid2-agent-kit",
  ],
  // Architecture zones. Deliberately narrow: ImportLint already enforces
  // imports at export granularity (every directory is a package; exports are
  // package-private unless tagged @public), which is what keeps risky
  // dependencies behind a narrow module (ADR 0004) and already blocks
  // src/ -> convex/ internals. Zones cover only what that model cannot see:
  // an export tagged @public is visible to the whole app, so nothing stops
  // src/bracket — the pure layout layer of ADR 0007 — from reaching into
  // src/lib/convex and acquiring a Convex client. This rule is that guard.
  // Keep the two tools on their own axes; do not restate ImportLint here.
  "boundaries": {
    "zones": [
      { "name": "bracket", "patterns": ["src/bracket/**"] },
      { "name": "client-data", "patterns": ["src/lib/**"] },
    ],
    "rules": [{ "from": "bracket", "allow": [] }],
  },

  // Semantic proof for traces, symbol-impact, and private-type hygiene.
  // best-effort: incomplete checker results stay advisory and do not fail CI.
  "typeAware": {
    "enabled": true,
    "require": "best-effort",
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "private-type-leaks": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unused-store-members": "error",
    "unprovided-injects": "error",
    "unrendered-components": "error",
    "unused-component-props": "error",
    "unused-component-emits": "error",
    "unused-component-inputs": "error",
    "unused-component-outputs": "error",
    "unused-svelte-events": "error",
    "unused-server-actions": "error",
    "unused-load-data-keys": "error",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "error",
    "css-token-drift": "error",
    "css-duplicate-block": "error",
    "css-selector-complexity": "error",
    "css-dead-surface": "error",
    "css-broken-reference": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "boundary-violation": "error",
    "feature-flags": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error",
    "unused-catalog-entries": "error",
    "empty-catalog-groups": "error",
    "unresolved-catalog-references": "error",
    "unused-dependency-overrides": "error",
    "misconfigured-dependency-overrides": "error",
    "security-client-server-leak": "error",
    "security-sink": "error",
    // Off: rule packs are policy-as-code, and none are authored. Left `error`
    // it reported zero violations because the detector never ran, which reads
    // like a clean result. Turn it back on in the change that adds `rulePacks`.
    "policy-violation": "off",
    "invalid-client-export": "error",
    "mixed-client-server-barrel": "error",
    "misplaced-directive": "error",
    "route-collision": "error",
    "dynamic-segment-name-conflict": "error",
    // On since src/bracket/*.test.ts gave the graph a path into src/. The
    // default run gates on it too in the current fallow line (3.33, when
    // this rule was adopted, consulted it only in
    // `fallow health --coverage-gaps`), so the listing is now
    // empty and any new untested runtime file fails the gate. Read the
    // listing, not the percentage: it is a static test-dependency graph, so
    // src/router.ts lazy-importing every page made it count Tournament.tsx
    // as covered the moment any page had a test, while nothing exercised a
    // line of it. Three files are structural and carry a reasoned
    // `fallow-ignore-file coverage-gaps` at their top instead: the two CLI
    // config entry points (cloudflare.config.ts, wrangler.config.ts — read
    // by the cf/wrangler CLIs, never imported) and scripts/lint-theme.ts,
    // whose tests drive it as a subprocess (the only way to run a Bun
    // script with its own Glob and cwd), and a subprocess is not an import
    // edge.
    "coverage-gaps": "error",
  },
}
